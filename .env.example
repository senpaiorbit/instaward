# instaward-bot local config. Copy to .env for local dev (never commit real secrets).
#
# RULE: any OPTIONAL value set to 0 (or none) counts as empty/disabled.
# Only ENV_KEY, TURSO_URL, TURSO_AUTH_TOKEN, INSTAGRAM_USERNAME and
# INSTAGRAM_PASSWORD are truly required — everything else works on defaults.

# --- Auth key (required): password for all routes except /health (403 without it) ---
ENV_KEY=change-me-long-random
# Alias: UPLOAD_SECRET (legacy fallback, used only when ENV_KEY is empty)

# --- Turso database (required): libsql URL + token ---
TURSO_URL=libsql://your-db.turso.io
# Alias: TURSO_DATABASE_URL (legacy fallback when TURSO_URL is empty)
TURSO_AUTH_TOKEN=your-turso-token

# --- Instagram login: username + password required; session cookies optional ---
INSTAGRAM_USERNAME=your_ig_username
INSTAGRAM_PASSWORD=your_ig_password
# Raw sessionid cookie (optional, 0 = skip): logs in without password and
# bypasses 2FA. Aliases: SESSION_ID, INSTAGRAM_SESSION (fallbacks).
INSTAGRAM_SESSIONID=0
# Raw csrftoken cookie (optional, 0 = skip). Alias: CSRF_TOKEN.
INSTAGRAM_CSRFTOKEN=0
# Raw ds_user_id cookie = your numeric user id (optional, 0 = skip). Alias: DS_USER_ID.
INSTAGRAM_DS_USER_ID=0
# aiograpi settings JSON (optional, 0 = skip): restored via set_settings before
# login; a refreshed copy is cached in Turso session_cache automatically.
INSTAGRAM_SESSION_STATE=0
# 2FA for password logins on protected accounts (optional, 0 = none):
# reusable base32 authenticator secret (preferred — a fresh code is derived per
# 30 s window) or a one-shot 6-digit/8-digit backup code. Never logged.
INSTAGRAM_TOTP_SEED=0
INSTAGRAM_2FA_CODE=0
# Truly unused legacy field (no effect whatever you set): DESTINATION_USERNAME

# --- Telegram notifications (optional, 0 = off): publish/scan/error alerts ---
TELEGRAM_BOT_TOKEN=0
TELEGRAM_CHAT_ID=0
# BOTLOG=1 sends Telegram notifications (needs both tokens above), 0 silences them.
BOTLOG=1

# --- Archive policy: retire OWN reposts older than ARCHIVE_TIME AND with views <= ARCHIVE_VIEWS ---
# Time format: {n}s/m/h/d or bare seconds (90m, 24h, 2d, 3600). Hourly scheduler uses these too.
ARCHIVE_TIME=24h
ARCHIVE_VIEWS=1000
# Max DB-tracked rows scanned per archive run (keeps free-plan runs small).
ARCHIVE_BATCH=50

# --- Quality gate: skip low-res videos, upload high-quality sources only ---
# Master switch: 1 = check every candidate, 0 = upload whatever downloads.
QUALITY_ENABLED=1
# Min video file size in bytes; smaller files are rejected as broken.
QUALITY_MIN_BYTES=300000
# Min video resolution (width x height px); real dimensions probed via ffprobe
# or stdlib MP4 parsing — rejects like "low-res 716x1272 < 720x960".
QUALITY_MIN_WIDTH=720
QUALITY_MIN_HEIGHT=960
# 1 = reject when resolution can't be determined; 0 = allow with a warning.
QUALITY_STRICT=0

# --- Auto-comment CTA on our own uploads (pins it). Off by default. ---
# 1 = comment on every publish; 0 = skip (also toggle per call: &comment=1/0).
COMMENT_ENABLED=0
# |-separated rotation, one random pick per post. Posted ONLY on our own
# just-published reposts, never anywhere else. Pin failures never fail publishes.
COMMENT_TEXT=FOLLOW ME 🔥|FOLLOW FOR MORE 🔥|FOLLOW ME ❤️

# --- Stealth & session ---
# Minutes an authenticated client is reused with zero re-logins (biggest IG-call saver).
SESSION_REUSE_TTL_MIN=120
# "min,max" seconds of human-like jitter before writes / between paginated reads.
IG_CALL_JITTER_SEC=1,3
# 1 = hide like/view counts on uploads via Instagram flag; 0 = show them.
HIDELIKE=1
# Alias: HIDE_LIKE_VIEW_COUNTS=true/false/1/0 (fallback when HIDELIKE empty)

# --- Covers: per-post ?thumb= URL beats THUMBNAIL_URL beats COVER_FILE beats COVER_DIR ---
# Must be direct *.jpg/*.jpeg/*.png/*.webp URLs (0 = none, falls through).
THUMBNAIL_URL=0
# How COVER_DIR is picked when no URL cover: random or static.
COVER_MODE=static
COVER_DIR=0
COVER_FILE=0

# --- Fetch & pacing ---
# Reel candidates pulled per upload run (more = more choice, more IG reads).
FETCH_COUNT=30
# REEL_FETCH_COUNT=30
# Min minutes between posts (slept INSIDE background jobs; same candidate retried, not counted).
MIN_POST_INTERVAL_MIN=30
# Hard daily post cap (0 = uploads disabled); hitting it fails the run with RateLimited.
MAX_PER_DAY=10
# Alias: MAX_UPLOADS_PER_RUN (clamped to MAX_PER_DAY)
# --- Logging & runtime ---
# INFO/DEBUG/WARNING/ERROR; 0 (or none/off) disables ALL logging.
LOG_LEVEL=INFO
PORT=8000
