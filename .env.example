# Copy to .env for local dev. Never commit real secrets.
# Canonical names first; legacy aliases below (fallback only when canonical empty).
ENV_KEY=change-me-long-random
# Alias: UPLOAD_SECRET (legacy fallback for ENV_KEY)
TURSO_URL=libsql://your-db.turso.io
# Alias: TURSO_DATABASE_URL (legacy fallback for TURSO_URL)
TURSO_AUTH_TOKEN=your-turso-token
INSTAGRAM_USERNAME=your_ig_username
INSTAGRAM_PASSWORD=your_ig_password
INSTAGRAM_SESSION_STATE=
# Ignored legacy raw-cookie fields (NOT aiograpi settings JSON, do not use):
# INSTAGRAM_SESSION=
# SESSION_ID=
# Unused legacy fields (no effect): CSRF_TOKEN, DS_USER_ID, DESTINATION_USERNAME
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ARCHIVE_TIME=12h
ARCHIVE_VIEWS=1000
HIDELIKE=1
# Alias: HIDE_LIKE_VIEW_COUNTS=true/false/1/0 (fallback when HIDELIKE empty)
BOTLOG=1
THUMBNAIL_URL=
# Cover fallback when THUMBNAIL_URL empty: COVER_MODE=random/static, COVER_DIR, COVER_FILE
COVER_MODE=static
COVER_DIR=
COVER_FILE=
# Fetch count: FETCH_COUNT (alias REEL_FETCH_COUNT), default 30
FETCH_COUNT=30
# REEL_FETCH_COUNT=30
MIN_POST_INTERVAL_MIN=30
MAX_PER_DAY=10
# Alias: MAX_UPLOADS_PER_RUN (clamped to MAX_PER_DAY)
LOG_LEVEL=INFO
PORT=8000
